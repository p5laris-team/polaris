# ai 서비스가 사용할 HTTP 포트
SERVER_PORT=18095

# ai 서비스가 사용할 PostgreSQL 접속 주소
DB_URL=jdbc:postgresql://localhost:5432/ai

# ai DB 접속 계정
DB_USERNAME=root

# ai DB 접속 비밀번호
DB_PASSWORD=12345678

# ai gRPC 서버가 열릴 포트
GRPC_SERVER_PORT=9095

# user 서비스 gRPC 주소
USER_GRPC_ADDRESS=static://localhost:9091

# character 서비스 gRPC 주소
# 캐릭터 타입/상태 기반 문구 생성에 필요한 캐릭터 정보를 조회할 때 사용
CHARACTER_GRPC_ADDRESS=static://localhost:9092

# item 서비스 gRPC 주소
ITEM_GRPC_ADDRESS=static://localhost:9093

# mission 서비스 gRPC 주소
MISSION_GRPC_ADDRESS=static://localhost:9094

# event-log 서비스 gRPC 주소
# AI 생성 성공/실패 같은 이벤트 기록에 사용
EVENT_LOG_GRPC_ADDRESS=static://localhost:9099

# Spring AI에서 사용할 chat model provider
SPRING_AI_MODEL_CHAT=google-genai

# Spring AI에서 사용할 embedding model provider
# 사용자 기억 RAG 검색용 text embedding 생성에 사용한다.
SPRING_AI_MODEL_EMBEDDING=google-genai

# Gemini API 키
# 실제 키는 커밋하지 말고 로컬/서버 환경변수에만 주입한다.
GEMINI_API_KEY=

# 외부 AI provider 호출 여부
# false면 외부 Gemini를 호출하지 않고 rule-based/seed fallback 응답을 사용한다.
AI_PROVIDER_ENABLED=true

# AI provider 종류
AI_PROVIDER_TYPE=gemini

# Gemini 모델명
AI_PROVIDER_MODEL=gemini-2.5-flash

# AI 응답 MIME 타입
# 미션 문구 생성은 JSON 파싱을 전제로 하므로 application/json을 사용한다.
# Gemini가 설명문/마크다운 대신 JSON 응답을 반환하도록 유도한다.
AI_PROVIDER_RESPONSE_MIME_TYPE=application/json

# 생성 다양성 조절값
# 값이 높을수록 답변이 다양해지고, 낮을수록 안정적인 문구가 나온다.
AI_PROVIDER_TEMPERATURE=0.4

# AI 응답 최대 토큰 수
# title, description, 캐릭터 제안 문구, 완료 질문, 완료 반응, category, difficulty를 JSON으로 받아야 한다.
# 너무 낮으면 응답 JSON이 중간에 잘려 fallback이 발생할 수 있으므로 Gemini 2.5 Flash 기준 1000 이상을 권장한다.
AI_PROVIDER_MAX_OUTPUT_TOKENS=1000

# Gemini thinking budget
# Polaris 미션 생성은 복잡한 추론보다 짧은 구조화 JSON 생성이 목적이다.
# thinking 예산을 크게 잡으면 비용/지연/응답 절단 위험이 커질 수 있어 0으로 둔다.
AI_PROVIDER_THINKING_BUDGET=0

# Gemini thoughts 포함 여부
# 서비스 응답에는 내부 사고 과정을 노출하지 않고, JSON 파싱 안정성을 우선하므로 false로 둔다.
AI_PROVIDER_INCLUDE_THOUGHTS=false

# Embedding provider 사용 여부
# false면 mission 모듈의 RAG 검색은 기존 recent memory fallback으로 동작한다.
AI_EMBEDDING_ENABLED=true

# Embedding 모델명
# mission DB의 user_memory_embeddings.embedding_model과 반드시 같은 값을 사용한다.
AI_EMBEDDING_MODEL=gemini-embedding-001

# Embedding 벡터 차원
# mission DB의 vector(768) 컬럼과 반드시 같은 값을 사용한다.
AI_EMBEDDING_DIMENSION=768

# AI provider rate limit 사용 여부
AI_RATE_LIMIT_ENABLED=true

# rate limit 저장소
AI_RATE_LIMIT_BACKEND=redis

# provider 전체 요청 제한: 분당 최대 요청 수
AI_RATE_LIMIT_PROVIDER_REQUESTS_PER_MINUTE=30

# 유저별 요청 제한: 분당 최대 요청 수
AI_RATE_LIMIT_USER_REQUESTS_PER_MINUTE=5

# rate limit 계산 윈도우(초)
AI_RATE_LIMIT_WINDOW_SECONDS=60

# rate limit key TTL(초)
# 윈도우보다 살짝 길게 둬서 만료 경계에서 카운터가 빨리 사라지는 것을 방지한다.
AI_RATE_LIMIT_KEY_TTL_SECONDS=70

# Redis/rate limit 확인 실패 시 요청을 막을지 여부
# true면 장애 시 외부 AI 과호출을 막는 쪽으로 동작한다.
AI_RATE_LIMIT_FAIL_CLOSED=true

# AI provider 서킷 브레이커 사용 여부
# true면 Gemini 실패/지연이 반복될 때 잠시 외부 호출을 끊고 기존 fallback 문구로 전환한다.
AI_CIRCUIT_BREAKER_ENABLED=true

# 서킷 브레이커가 최근 몇 번의 외부 AI 호출을 기준으로 실패율을 계산할지 정한다.
AI_CIRCUIT_BREAKER_SLIDING_WINDOW_SIZE=10

# 실패율 계산을 시작하기 전에 최소 몇 번의 호출을 관찰할지 정한다.
AI_CIRCUIT_BREAKER_MINIMUM_NUMBER_OF_CALLS=5

# 이 실패율을 넘으면 서킷을 열어 외부 AI 호출을 잠시 차단한다.
AI_CIRCUIT_BREAKER_FAILURE_RATE_THRESHOLD=50

# 이 시간보다 오래 걸리는 외부 AI 호출은 slow call로 본다.
AI_CIRCUIT_BREAKER_SLOW_CALL_DURATION_MS=3000

# slow call 비율이 이 값을 넘으면 서킷을 열 수 있다.
AI_CIRCUIT_BREAKER_SLOW_CALL_RATE_THRESHOLD=50

# 서킷이 열린 뒤 다시 Gemini 호출을 시도하기 전까지 기다릴 시간이다.
AI_CIRCUIT_BREAKER_WAIT_DURATION_OPEN_MS=30000

# Redis host
REDIS_HOST=localhost

# Redis port
REDIS_PORT=6379

# Redis 비밀번호
# 로컬 Redis에 비밀번호가 없으면 비워둔다.
REDIS_PASSWORD=

# Redis 연결 timeout
REDIS_TIMEOUT=200ms
