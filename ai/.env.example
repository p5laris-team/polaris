# AI 모듈 로컬 실행용 환경변수 예시 파일입니다.
# 실제 키가 들어가는 .env 파일은 git에 올리지 않습니다.

# 기본값은 local generator입니다.
# 외부 AI를 붙이지 않아도 서버와 테스트가 돌아가야 하므로 기본값은 안전하게 false/local로 둡니다.
AI_PROVIDER_ENABLED=false
AI_PROVIDER_TYPE=local
AI_PROVIDER_MODEL=local-tone-v1

# Gemini를 실제 호출할 때는 아래처럼 바꿔서 ai/.env 파일에 넣습니다.
# AI_PROVIDER_ENABLED=true
# AI_PROVIDER_TYPE=gemini
# AI_PROVIDER_MODEL=gemini-2.5-flash
# SPRING_AI_MODEL_CHAT=google-genai
# GEMINI_API_KEY=replace-with-your-gemini-api-key

# OpenAI는 provider 구조를 맞춘 뒤 같은 방식으로 켤 수 있게 둡니다.
# 이번 PR에서 OpenAI adapter까지 포함하지 않는다면 이 값들은 주석 상태로만 참고합니다.
# AI_PROVIDER_ENABLED=true
# AI_PROVIDER_TYPE=openai
# AI_PROVIDER_MODEL=gpt-5-mini
# SPRING_AI_MODEL_CHAT=openai
# OPENAI_API_KEY=replace-with-your-openai-api-key

# 외부 AI 호출 옵션입니다.
# 짧은 미션 문구 생성이 목적이라 낮은 temperature와 제한된 출력 길이를 기본값으로 둡니다.
AI_PROVIDER_TEMPERATURE=0.4
AI_PROVIDER_MAX_OUTPUT_TOKENS=500
AI_PROVIDER_TIMEOUT_SECONDS=5

# AI provider 호출량 보호 설정입니다.
# Gemini/OpenAI는 유료 외부 API이므로 실제 provider를 켤 때는 rate limit도 함께 켭니다.
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_BACKEND=redis
AI_RATE_LIMIT_PROVIDER_REQUESTS_PER_MINUTE=30
AI_RATE_LIMIT_USER_REQUESTS_PER_MINUTE=5
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_KEY_TTL_SECONDS=70
AI_RATE_LIMIT_FAIL_CLOSED=true

# Redis는 모든 AI 서버 인스턴스가 같은 호출량 카운터를 보게 하는 중앙 저장소입니다.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=200ms
